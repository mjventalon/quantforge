# Copy to .env and fill in what you have. .env is git-ignored — never commit it.

# ---- market data (Yahoo Finance and FRED work without any key)
QUANTFORGE_PROVIDER=yahoo
POLYGON_API_KEY=          # Massive (ex-Polygon.io); MASSIVE_API_KEY also works
FMP_API_KEY=
ALPHAVANTAGE_API_KEY=
FRED_API_KEY=

# ---- AI copilot (optional; visitors can also paste their own key in the app)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---- branding / public deployment
QUANTFORGE_SITE_URL=              # e.g. https://quantforge.example.com (printed on certificates)
QUANTFORGE_CONTACT_EMAIL=         # dedicated project address shown on Creator & Policies pages
QUANTFORGE_GITHUB=                # e.g. https://github.com/<you>/quantforge
QUANTFORGE_SEC_USER_AGENT=        # "quantforge contact@example.com" (SEC asks for a contact)

# ---- paper trading: where accounts are saved (default ~/.quantforge)
QUANTFORGE_DATA_DIR=

# ---- Academy certificates (REQUIRED on a public server, keep it secret)
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
QUANTFORGE_CERT_SECRET=

# ---- code execution for Academy exercises
# quantforge-app sets this to 1 on your own computer. NEVER enable it on a public server.
# QUANTFORGE_ALLOW_CODE_EXECUTION=0     # uncomment to force it off
